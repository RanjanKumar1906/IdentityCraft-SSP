<%- include('partials/header') %>

<!-- Banner operational indicator -->
<div id="operational-banner" class="status-banner <%= bannerClass %>">
  <div class="status-banner-title">
    <span class="pulse-dot"></span>
    <%= bannerTitle %>
  </div>
  <p class="mb-0 opacity-75"><%= bannerText %></p>
  <small class="text-muted d-block mt-2">Last checked: <%= new Date().toLocaleTimeString() %></small>
</div>

<!-- Search Customer Service ID -->
<div class="card glass-panel shadow-sm mb-4">
  <div class="card-body p-4 text-center">
    <h3 class="fw-bold mb-2">Check Your Service Status</h3>
    <p id="search-helper-text" class="text-secondary small mb-3">
      <% if (activeIncidentsCount > 0) { %>
        Some services are affected. Search your service to check whether it is impacted.
      <% } else { %>
        Everything is working as expected. Search your service to verify its current status.
      <% } %>
    </p>
    
    <form id="service-search-form" class="d-flex justify-content-center">
      <div class="input-group" style="max-width: 600px;">
        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="fas fa-search"></i></span>
        <input type="text" id="service-search-input" class="form-control border-start-0 ps-0" placeholder="Enter Customer ID [e.g. domain1.com]" required autocomplete="off">
        <button type="submit" class="btn btn-primary fw-bold px-4">Search</button>
      </div>
    </form>
    
    <!-- Search Results Container -->
    <div id="search-result-container" class="mt-2"></div>
  </div>
</div>

<!-- Active/Affected Servers Panel (Loaded Dynamically) -->
<div id="active-servers-container" class="mb-4">
  <% if (activeServers && activeServers.length > 0) { %>
    <h4 class="mb-3"><i class="fas fa-exclamation-circle text-danger me-2"></i>Affected Servers</h4>
    <% activeServers.forEach(function(server) { %>
      <div class="card glass-panel mb-3 border-danger shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="card-title mb-1 text-danger fw-bold">
              <i class="fas fa-server me-2"></i><%= server.server_name %> (<%= server.server_code %>)
            </h5>
            <% 
              let badgeClass = 'outage';
              if (server.incident_type.toLowerCase().includes('maintenance')) badgeClass = 'maintenance';
              else if (server.incident_type.toLowerCase().includes('degraded')) badgeClass = 'degraded';
              else if (server.incident_type.toLowerCase().includes('security')) badgeClass = 'security';
            %>
            <span class="status-badge <%= badgeClass %>"><%= server.incident_type %></span>
          </div>
          <p class="card-text mt-2 mb-1"><strong>Incident:</strong> <%= server.incident_title %></p>
          <p class="card-text text-muted mb-2"><small><i class="fas fa-calendar-alt me-1"></i>Duration: <%= new Date(server.start_time).toLocaleString() %> &mdash; <%= new Date(server.end_time).toLocaleString() %> | <i class="fas fa-map-marker-alt me-1"></i>Location: <%= server.location %></small></p>
          <p class="card-text mt-2 mb-0"><%= server.public_message || server.description %></p>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<hr class="my-5">

<!-- Incidents Listing Sections -->
<div class="row g-4">
  <!-- Left Side: Current & Scheduled Incidents -->
  <div class="col-lg-8">
    
    <!-- Section 1: Current Incidents -->
    <div class="mb-5">
      <h3 class="fw-bold mb-4"><i class="fas fa-bolt text-danger me-2"></i>Current Incidents</h3>
      <% if (currentIncidents && currentIncidents.length > 0) { %>
        <% currentIncidents.forEach(function(inc) { %>
          <div class="timeline-card active-inc p-3 glass-panel mb-3 border-start border-danger border-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <h5 class="fw-bold mb-0 text-danger"><%= inc.title %></h5>
              <span class="status-badge outage"><%= inc.type %></span>
            </div>
            <p class="text-secondary small mt-1 mb-2">
              <i class="fas fa-clock me-1"></i>Started: <%= new Date(inc.start_time).toLocaleString() %> | Severity: <strong class="text-danger"><%= inc.severity %></strong>
            </p>
            <p class="mb-2"><%= inc.public_message || inc.description %></p>
            <% if (inc.expected_resolution) { %>
              <div class="text-muted small mt-2"><i class="fas fa-hourglass-half me-1"></i><strong>Expected Resolution:</strong> <%= inc.expected_resolution %></div>
            <% } %>
          </div>
        <% }) %>
        
        <!-- Pagination -->
        <% if (currentTotalPages > 1) { %>
          <nav aria-label="Current incidents pagination">
            <ul class="pagination pagination-sm justify-content-end">
              <% for (let i = 1; i <= currentTotalPages; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                  <a class="page-link" href="?current_page=<%= i %>&scheduled_page=<%= scheduledPage %>&past_page=<%= pastPage %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>
        
      <% } else { %>
        <div class="alert alert-custom alert-success">
          <i class="fas fa-check-circle me-2 text-success"></i>No active incidents reported.
        </div>
      <% } %>
    </div>

    <!-- Section 2: Scheduled Incidents -->
    <div class="mb-5">
      <h3 class="fw-bold mb-4"><i class="fas fa-calendar-alt text-primary me-2"></i>Scheduled Maintenance</h3>
      <% if (scheduledIncidents && scheduledIncidents.length > 0) { %>
        <% scheduledIncidents.forEach(function(inc) { %>
          <div class="timeline-card p-3 glass-panel mb-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <h5 class="fw-bold mb-0 text-primary"><%= inc.title %></h5>
              <span class="status-badge maintenance">Scheduled</span>
            </div>
            <p class="text-secondary small mt-1 mb-2">
              <i class="fas fa-clock me-1"></i>Window: <%= new Date(inc.start_time).toLocaleString() %> &mdash; <%= new Date(inc.end_time).toLocaleString() %>
            </p>
            <p class="mb-2"><%= inc.public_message || inc.description %></p>
            <% if (inc.maintenance_window) { %>
              <div class="text-muted small mt-2"><i class="fas fa-stopwatch me-1"></i><strong>Window:</strong> <%= inc.maintenance_window %></div>
            <% } %>
          </div>
        <% }) %>
        
        <!-- Pagination -->
        <% if (scheduledTotalPages > 1) { %>
          <nav aria-label="Scheduled incidents pagination">
            <ul class="pagination pagination-sm justify-content-end">
              <% for (let i = 1; i <= scheduledTotalPages; i++) { %>
                <li class="page-item <%= scheduledPage === i ? 'active' : '' %>">
                  <a class="page-link" href="?current_page=<%= currentPage %>&scheduled_page=<%= i %>&past_page=<%= pastPage %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>
        
      <% } else { %>
        <div class="alert alert-custom alert-success">
          <i class="fas fa-check-circle me-2 text-success"></i>No upcoming maintenance windows.
        </div>
      <% } %>
    </div>

  </div>

  <!-- Right Side: Past Incidents Timeline -->
  <div class="col-lg-4">
    <h3 class="fw-bold mb-4"><i class="fas fa-history text-muted me-2"></i>Past Incidents</h3>
    <% if (pastIncidents && pastIncidents.length > 0) { %>
      <% pastIncidents.forEach(function(inc) { %>
        <div class="timeline-card resolved p-3 glass-panel mb-3 border-start border-success border-4">
          <h6 class="fw-bold text-success mb-1"><%= inc.title %></h6>
          <span class="status-badge operational mb-2" style="font-size: 0.65rem;">Resolved</span>
          
          <p class="text-secondary small mb-1">
            <strong>Server:</strong> <%= inc.server_names || 'Multiple Servers' %>
          </p>
          <p class="text-secondary small mb-1">
            <strong>Duration:</strong> 
            <% 
              const diffMs = new Date(inc.end_time) - new Date(inc.start_time);
              const diffHrs = Math.floor(diffMs / (1000 * 60 * 60));
              const diffMins = Math.round((diffMs % (1000 * 60 * 60)) / (1000 * 60));
              let durStr = '';
              if (diffHrs > 0) durStr += diffHrs + 'h ';
              durStr += diffMins + 'm';
            %>
            <%= durStr %>
          </p>
          <p class="text-secondary small mb-2">
            <strong>Resolved:</strong> <%= new Date(inc.end_time).toLocaleString() %>
          </p>
          <p class="small text-muted mb-0"><%= inc.public_message || inc.description %></p>
        </div>
      <% }) %>
      
      <!-- Pagination -->
      <% if (pastTotalPages > 1) { %>
        <nav aria-label="Past incidents pagination">
          <ul class="pagination pagination-sm justify-content-end">
            <% for (let i = 1; i <= pastTotalPages; i++) { %>
              <li class="page-item <%= pastPage === i ? 'active' : '' %>">
                <a class="page-link" href="?current_page=<%= currentPage %>&scheduled_page=<%= scheduledPage %>&past_page=<%= i %>"><%= i %></a>
              </li>
            <% } %>
          </ul>
        </nav>
      <% } %>
      
    <% } else { %>
      <div class="alert alert-custom alert-success">
        <i class="fas fa-check-circle me-2 text-success"></i>No past incidents reported.
      </div>
    <% } %>
  </div>
</div>

<!-- Load public javascript -->
<script src="/js/public-app.js"></script>

<%- include('partials/footer') %>
