<%- include('partials/header') %>

<div class="row mb-4">
  <div class="col-12">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="fw-bold mb-1">Admin Dashboard</h1>
        <p class="text-secondary text-muted mb-0">System controls, customer services, and incident management.</p>
      </div>
      <div class="text-muted small d-flex align-items-center gap-2">
        <i class="fas fa-user-circle me-1"></i> Logged in as: <strong class="me-1"><%= adminUsername %></strong>
        <button class="btn btn-sm btn-outline-primary border-0 p-1 d-inline-flex align-items-center justify-content-center" data-bs-toggle="modal" data-bs-target="#editAdminModal" title="Edit Admin Details" style="text-decoration: none; width: 28px; height: 28px; border-radius: 50%;"><i class="fas fa-pen text-primary font-size-sm"></i></button>
      </div>
    </div>
  </div>
</div>

<!-- Alerts from session -->
<% if (locals.errors && locals.errors.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <h5 class="alert-heading fw-bold mb-2"><i class="fas fa-exclamation-circle me-2"></i>Validation Errors</h5>
    <ul class="mb-0 small">
      <% locals.errors.forEach(function(err) { %>
        <li><%= err %></li>
      <% }) %>
    </ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (locals.success_msg) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="fas fa-check-circle me-2"></i><%= success_msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Stats Row -->
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="admin-card-stat">
      <div>
        <span class="text-muted small d-block uppercase fw-bold">Hosting Servers</span>
        <h3 class="fw-bold mb-0 mt-1"><%= stats.serversCount %></h3>
      </div>
      <div class="admin-stat-icon">
        <i class="fas fa-server"></i>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="admin-card-stat">
      <div>
        <span class="text-muted small d-block uppercase fw-bold">Active Services</span>
        <h3 class="fw-bold mb-0 mt-1"><%= stats.servicesCount %></h3>
      </div>
      <div class="admin-stat-icon">
        <i class="fas fa-globe text-success"></i>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="admin-card-stat">
      <div>
        <span class="text-muted small d-block uppercase fw-bold">Active Incidents</span>
        <h3 class="fw-bold mb-0 mt-1"><%= stats.activeIncidentsCount %></h3>
      </div>
      <div class="admin-stat-icon">
        <i class="fas fa-exclamation-triangle text-warning"></i>
      </div>
    </div>
  </div>
</div>

<!-- Main Modules Navigation -->
<ul class="nav nav-tabs mb-4" id="dashboardTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link <%= activeTab === 'servers' ? 'active' : '' %>" id="servers-tab" data-bs-toggle="tab" data-bs-target="#servers-panel" type="button" role="tab" aria-controls="servers-panel" aria-selected="<%= activeTab === 'servers' %>"><i class="fas fa-server me-2"></i>Servers</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link <%= activeTab === 'clients' ? 'active' : '' %>" id="clients-tab" data-bs-toggle="tab" data-bs-target="#clients-panel" type="button" role="tab" aria-controls="clients-panel" aria-selected="<%= activeTab === 'clients' %>"><i class="fas fa-users me-2"></i>Clients &amp; Services</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link <%= activeTab === 'incidents' ? 'active' : '' %>" id="incidents-tab" data-bs-toggle="tab" data-bs-target="#incidents-panel" type="button" role="tab" aria-controls="incidents-panel" aria-selected="<%= activeTab === 'incidents' %>"><i class="fas fa-exclamation-circle me-2"></i>Incidents</button>
  </li>
</ul>

<!-- Tabs Contents -->
<div class="tab-content" id="dashboardTabsContent">
  
  <!-- ================= MODULE 1: SERVERS ================= -->
  <div class="tab-pane fade <%= activeTab === 'servers' ? 'show active' : '' %>" id="servers-panel" role="tabpanel" aria-labelledby="servers-tab">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <!-- Search Server -->
      <form action="/admin" method="GET" class="d-flex gap-2">
        <input type="hidden" name="tab" value="servers">
        <div class="search-wrapper">
          <i class="fas fa-search"></i>
          <input type="text" name="server_search" class="form-control form-control-sm" placeholder="Search servers..." value="<%= serverSearch %>">
        </div>
        <button type="submit" class="btn btn-primary btn-sm px-3">Filter</button>
      </form>
      
      <!-- Add Server Toggle -->
      <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#addServerCollapse" aria-expanded="false" aria-controls="addServerCollapse">
        <i class="fas fa-plus me-1"></i> Add Server
      </button>
    </div>

    <!-- Hidden Add Server Form -->
    <div class="collapse mb-4" id="addServerCollapse">
      <div class="card card-body shadow-sm">
        <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary"><i class="fas fa-server me-2"></i>Add Hosting Server</h5>
        <form action="/admin/servers/add" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-3">
            <div class="col-md-6 col-lg-3">
              <label for="server_name" class="form-label small fw-bold">Server Name</label>
              <input type="text" class="form-control form-control-sm" name="server_name" required>
            </div>
            <div class="col-md-6 col-lg-3">
              <label for="server_code" class="form-label small fw-bold">Server Code (Unique)</label>
              <input type="text" class="form-control form-control-sm" name="server_code" placeholder="e.g. SRV-USA-01" required>
            </div>
            <div class="col-md-6 col-lg-3">
              <label for="ip_address" class="form-label small fw-bold">IP Address</label>
              <input type="text" class="form-control form-control-sm" name="ip_address" placeholder="e.g. 192.168.1.1" required>
            </div>
            <div class="col-md-6 col-lg-3">
              <label for="location" class="form-label small fw-bold">Location</label>
              <input type="text" class="form-control form-control-sm" name="location" placeholder="e.g. New York, USA" required>
            </div>
            <div class="col-md-6 col-lg-3">
              <label for="status" class="form-label small fw-bold">Status</label>
              <select class="form-select form-select-sm" name="status" required>
                <option value="Operational">Operational</option>
                <option value="Maintenance">Maintenance</option>
                <option value="Degraded Performance">Degraded Performance</option>
                <option value="Down">Down</option>
              </select>
            </div>
            <div class="col-lg-9">
              <label for="description" class="form-label small fw-bold">Description</label>
              <input type="text" class="form-control form-control-sm" name="description" placeholder="Optional description details...">
            </div>
          </div>
          <button type="submit" class="btn btn-success btn-sm fw-bold mt-3"><i class="fas fa-save me-1"></i>Save Server</button>
        </form>
      </div>
    </div>

    <!-- Servers Listing -->
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Server Name</th>
              <th>Code</th>
              <th>IP Address</th>
              <th>Location</th>
              <th>Status</th>
              <th>Description</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (servers && servers.length > 0) { %>
              <% servers.forEach(function(server) { %>
                <tr>
                  <td><strong><%= server.server_name %></strong></td>
                  <td><code><%= server.server_code %></code></td>
                  <td><%= server.ip_address %></td>
                  <td><%= server.location %></td>
                  <td>
                    <% 
                      let badge = 'operational';
                      if (server.status.toLowerCase().includes('maintenance')) badge = 'maintenance';
                      else if (server.status.toLowerCase().includes('degraded')) badge = 'degraded';
                      else if (server.status.toLowerCase().includes('down')) badge = 'outage';
                    %>
                    <span class="status-badge <%= badge %>"><%= server.status %></span>
                  </td>
                  <td class="text-truncate text-muted small" style="max-width: 200px;"><%= server.description || '-' %></td>
                  <td class="text-end">
                    <button class="btn btn-outline-primary btn-sm py-1 px-2 border-0" data-bs-toggle="modal" data-bs-target="#editServerModal" data-server="<%= JSON.stringify(server) %>" title="Edit Server"><i class="fas fa-pencil"></i></button>
                    <button class="btn btn-outline-danger btn-sm py-1 px-2 border-0" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-delete-url="/admin/servers/<%= server.id %>/delete" data-item-title="Server <%= server.server_name %> (<%= server.server_code %>)" title="Delete Server"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">No servers found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Servers Pagination -->
    <% if (serverTotalPages > 1) { %>
      <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-end">
          <% for (let i = 1; i <= serverTotalPages; i++) { %>
            <li class="page-item <%= serverPage === i ? 'active' : '' %>">
              <a class="page-link" href="?tab=servers&server_page=<%= i %>&server_search=<%= serverSearch %>"><%= i %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    <% } %>
  </div>

  <!-- ================= MODULE 2: CLIENTS & SERVICES ================= -->
  <div class="tab-pane fade <%= activeTab === 'clients' ? 'show active' : '' %>" id="clients-panel" role="tabpanel" aria-labelledby="clients-tab">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <!-- Search Client -->
      <form action="/admin" method="GET" class="d-flex gap-2">
        <input type="hidden" name="tab" value="clients">
        <div class="search-wrapper">
          <i class="fas fa-search"></i>
          <input type="text" name="client_search" class="form-control form-control-sm" placeholder="Search domain, name, email..." value="<%= clientSearch %>">
        </div>
        <button type="submit" class="btn btn-primary btn-sm px-3">Filter</button>
      </form>
      
      <!-- Add Client Toggle -->
      <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#addClientCollapse" aria-expanded="false" aria-controls="addClientCollapse">
        <i class="fas fa-plus me-1"></i> Add Client Service
      </button>
    </div>

    <!-- Hidden Add Client Form -->
    <div class="collapse mb-4" id="addClientCollapse">
      <div class="card card-body shadow-sm">
        <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary"><i class="fas fa-user-plus me-2"></i>Add Client &amp; Service Domain</h5>
        <form action="/admin/clients/add" method="POST" id="add-client-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="row g-3">
            <div class="col-md-6 col-lg-3">
              <label for="client_name" class="form-label small fw-bold">Client Name</label>
              <input type="text" class="form-control form-control-sm" name="client_name" required>
            </div>
            <div class="col-md-6 col-lg-3">
              <label for="company_name" class="form-label small fw-bold">Company Name</label>
              <input type="text" class="form-control form-control-sm" name="company_name" required>
            </div>
            <div class="col-md-6 col-lg-3">
              <label for="contact_person" class="form-label small fw-bold">Contact Person (Optional)</label>
              <input type="text" class="form-control form-control-sm" name="contact_person">
            </div>
            <div class="col-md-6 col-lg-3">
              <label for="email" class="form-label small fw-bold">Email Address</label>
              <input type="email" class="form-control form-control-sm" name="email" required>
            </div>
            <div class="col-md-6 col-lg-3">
              <label for="phone" class="form-label small fw-bold">Phone Number (Optional)</label>
              <input type="text" class="form-control form-control-sm" name="phone">
            </div>
            
            <div class="col-md-6 col-lg-4">
              <label for="service_id" class="form-label small fw-bold">Service ID / Domain Name (Unique)</label>
              <input type="text" class="form-control form-control-sm" name="service_id" placeholder="e.g. customerdomain.com" required>
            </div>
            
            <div class="col-md-6 col-lg-4">
              <label for="server_id" class="form-label small fw-bold">Assign Hosting Server</label>
              <select class="form-select form-select-sm" name="server_id" id="client-server-select" required>
                <option value="">-- Select Server --</option>
                <% allServersList.forEach(function(s) { %>
                  <option value="<%= s.id %>"><%= s.server_name %> (<%= s.server_code %>)</option>
                <% }) %>
              </select>
            </div>
          </div>
          
          <!-- Incident Alert Container for Client Registration -->
          <div id="client-incident-alert-container"></div>
          
          <button type="submit" class="btn btn-success btn-sm fw-bold mt-3"><i class="fas fa-save me-1"></i>Save Client &amp; Service</button>
        </form>
      </div>
    </div>

    <!-- Clients Listing -->
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Client Name</th>
              <th>Company Name</th>
              <th>Service ID (Domain)</th>
              <th>Assigned Server</th>
              <th>Email</th>
              <th>Current Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (clients && clients.length > 0) { %>
              <% clients.forEach(function(client) { %>
                <tr>
                  <td><strong><%= client.client_name %></strong></td>
                  <td><%= client.company_name %></td>
                  <td><code class="text-primary fw-bold"><%= client.service_id %></code></td>
                  <td><%= client.server_name %> (<%= client.server_code %>)</td>
                  <td><a href="mailto:<%= client.email %>" class="text-decoration-none small text-secondary"><%= client.email %></a></td>
                  <td>
                    <% 
                      let badge = 'operational';
                      let statusText = 'Operational';
                      if (client.active_status === 0) {
                        badge = 'degraded';
                        statusText = 'Inactive';
                      } else if (client.incident_type) {
                        statusText = client.incident_type;
                        if (client.incident_type.toLowerCase().includes('maintenance')) badge = 'maintenance';
                        else if (client.incident_type.toLowerCase().includes('degraded')) badge = 'degraded';
                        else if (client.incident_type.toLowerCase().includes('outage') || client.incident_type.toLowerCase().includes('down')) badge = 'outage';
                        else if (client.incident_type.toLowerCase().includes('security')) badge = 'security';
                      }
                    %>
                    <span class="status-badge <%= badge %>"><%= statusText %></span>
                  </td>
                  <td class="text-end">
                    <button class="btn btn-outline-primary btn-sm py-1 px-2 border-0" data-bs-toggle="modal" data-bs-target="#editClientModal" data-client="<%= JSON.stringify(client) %>" title="Edit Client"><i class="fas fa-pencil"></i></button>
                    <button class="btn btn-outline-danger btn-sm py-1 px-2 border-0" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-delete-url="/admin/clients/<%= client.id %>/delete?service_id=<%= client.service_id %>" data-item-title="Service domain <%= client.service_id %> under client <%= client.client_name %>" title="Delete Client"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">No clients or services found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Clients Pagination -->
    <% if (clientTotalPages > 1) { %>
      <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-end">
          <% for (let i = 1; i <= clientTotalPages; i++) { %>
            <li class="page-item <%= clientPage === i ? 'active' : '' %>">
              <a class="page-link" href="?tab=clients&client_page=<%= i %>&client_search=<%= clientSearch %>"><%= i %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    <% } %>
  </div>

  <!-- ================= MODULE 3: INCIDENTS ================= -->
  <div class="tab-pane fade <%= activeTab === 'incidents' ? 'show active' : '' %>" id="incidents-panel" role="tabpanel" aria-labelledby="incidents-tab">
    
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <!-- Search Incidents -->
      <form action="/admin" method="GET" class="d-flex gap-2">
        <input type="hidden" name="tab" value="incidents">
        <div class="search-wrapper">
          <i class="fas fa-search"></i>
          <input type="text" name="incident_search" class="form-control form-control-sm" placeholder="Search incidents..." value="<%= incidentSearch %>">
        </div>
        <button type="submit" class="btn btn-primary btn-sm px-3">Filter</button>
      </form>
      
      <!-- Add Incident Toggle -->
      <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#addIncidentCollapse" aria-expanded="false" aria-controls="addIncidentCollapse">
        <i class="fas fa-plus me-1"></i> Add Incident
      </button>
    </div>

    <!-- Hidden Add Incident Form -->
    <div class="collapse mb-4" id="addIncidentCollapse">
      <div class="card card-body shadow-sm">
        <h5 class="fw-bold mb-3 border-bottom pb-2 text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Declare Incident / Scheduled Maintenance</h5>
        <form action="/admin/incidents/add" method="POST" id="add-incident-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="row g-3">
            <div class="col-md-6 col-lg-3">
              <label for="title" class="form-label small fw-bold">Incident Title</label>
              <input type="text" class="form-control form-control-sm" name="title" required>
            </div>
            
            <div class="col-md-6 col-lg-3">
              <label for="type" class="form-label small fw-bold">Incident Type</label>
              <select class="form-select form-select-sm" name="type" required>
                <option value="Down">Down</option>
                <option value="Maintenance">Maintenance</option>
                <option value="Degraded Performance">Degraded Performance</option>
                <option value="Partial Outage">Partial Outage</option>
                <option value="Major Outage">Major Outage</option>
                <option value="Security Issue">Security Issue</option>
                <option value="Network Issue">Network Issue</option>
                <option value="Database Issue">Database Issue</option>
              </select>
            </div>
            
            <div class="col-md-6 col-lg-3">
              <label for="severity" class="form-label small fw-bold">Severity</label>
              <select class="form-select form-select-sm" name="severity" required>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>
              </select>
            </div>
            
            <div class="col-md-6 col-lg-3">
              <label for="start_time" class="form-label small fw-bold">Start Date &amp; Time</label>
              <input type="datetime-local" class="form-control form-control-sm" name="start_time" required>
            </div>
            
            <div class="col-md-6 col-lg-3">
              <label for="end_time" class="form-label small fw-bold">End Date &amp; Time</label>
              <input type="datetime-local" class="form-control form-control-sm" name="end_time" required>
            </div>
            
            <div class="col-md-6 col-lg-3">
              <label for="maintenance_window" class="form-label small fw-bold">Est. Downtime (e.g. 1 hour)</label>
              <input type="text" class="form-control form-control-sm" name="maintenance_window" placeholder="e.g. 30 minutes">
            </div>
            
            <div class="col-md-6 col-lg-3">
              <label for="expected_resolution" class="form-label small fw-bold">Expected Resolution</label>
              <input type="text" class="form-control form-control-sm" name="expected_resolution" placeholder="e.g. Resolving database CPU loop">
            </div>

            <!-- Server Selection (Multiple Servers Allowed) -->
            <div class="col-12 border p-3 rounded bg-light text-dark">
              <label class="form-label fw-bold small text-secondary d-block mb-2">Affected Servers (Select one or more)</label>
              <% allServersList.forEach(function(s) { %>
                <div class="form-check form-check-inline mb-1">
                  <input class="form-check-input" type="checkbox" name="servers" id="add-inc-server-<%= s.id %>" value="<%= s.id %>">
                  <label class="form-check-label small" for="add-inc-server-<%= s.id %>">
                    <%= s.server_name %> (<code><%= s.server_code %></code>)
                  </label>
                </div>
              <% }) %>
            </div>
            
            <!-- Dynamic Services Checklist (populated by AJAX in admin-app.js) -->
            <div class="col-12" id="incident-services-checklist">
              <p class="text-muted small">Select a server above to load hosted services.</p>
            </div>
            
            <!-- Messages -->
            <div class="col-md-6">
              <label for="description" class="form-label small fw-bold">Description</label>
              <textarea class="form-control form-control-sm" name="description" rows="2" placeholder="Internal technical description..."></textarea>
            </div>
            <div class="col-md-6">
              <label for="public_message" class="form-label small fw-bold">Public message (Visible on Status page)</label>
              <textarea class="form-control form-control-sm" name="public_message" rows="2" placeholder="Public status message for users..."></textarea>
            </div>
            <div class="col-md-6">
              <label for="internal_notes" class="form-label small fw-bold">Internal Notes (Admin Only)</label>
              <textarea class="form-control form-control-sm" name="internal_notes" rows="2"></textarea>
            </div>
            <div class="col-md-6">
              <label for="root_cause" class="form-label small fw-bold">Root Cause (Admin Only)</label>
              <textarea class="form-control form-control-sm" name="root_cause" rows="2"></textarea>
            </div>
          </div>
          
          <button type="submit" class="btn btn-danger btn-sm fw-bold mt-3"><i class="fas fa-save me-1"></i>Publish Incident</button>
        </form>
      </div>
    </div>

    <!-- Incidents Grouped Lists -->
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Title</th>
              <th>Type</th>
              <th>Severity</th>
              <th>Lifecycle Status</th>
              <th>Time Window</th>
              <th class="text-center">Reminder Alert</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (incidents && incidents.length > 0) { %>
              <% incidents.forEach(function(inc) { %>
                <tr>
                  <td>
                    <strong><%= inc.title %></strong><br>
                    <small class="text-muted">Servers: <%= inc.server_names || 'None' %></small>
                  </td>
                  <td>
                    <% 
                      let badge = 'outage';
                      if (inc.type.toLowerCase().includes('maintenance')) badge = 'maintenance';
                      else if (inc.type.toLowerCase().includes('degraded')) badge = 'degraded';
                      else if (inc.type.toLowerCase().includes('security')) badge = 'security';
                    %>
                    <span class="status-badge <%= badge %>"><%= inc.type %></span>
                  </td>
                  <td><span class="badge bg-secondary"><%= inc.severity %></span></td>
                  <td>
                    <% 
                      let statusBadge = 'operational';
                      if (inc.status === 'Active') statusBadge = 'outage';
                      else if (inc.status === 'Scheduled') statusBadge = 'maintenance';
                    %>
                    <span class="status-badge <%= statusBadge %>"><%= inc.status %></span>
                  </td>
                  <td class="small">
                    <%= new Date(inc.start_time).toLocaleString() %><br>
                    <span class="text-muted">to</span> <%= new Date(inc.end_time).toLocaleString() %>
                  </td>
                  <td class="text-center">
                    <% if (inc.status === 'Scheduled') { %>
                      <form action="/admin/incidents/<%= inc.id %>/notify" method="POST" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-primary btn-xs py-1 px-2 fw-bold" title="Notify Reminder manually"><i class="fas fa-bell me-1"></i>Notify</button>
                      </form>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <button class="btn btn-outline-primary btn-sm py-1 px-2 border-0" data-bs-toggle="modal" data-bs-target="#editIncidentModal" data-incident-id="<%= inc.id %>" title="Edit Incident"><i class="fas fa-pencil"></i></button>
                    <button class="btn btn-outline-danger btn-sm py-1 px-2 border-0" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-delete-url="/admin/incidents/<%= inc.id %>/delete" data-item-title="Incident <%= inc.title %>" title="Delete Incident"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">No incidents found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Incidents Pagination -->
    <% if (incidentTotalPages > 1) { %>
      <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-end">
          <% for (let i = 1; i <= incidentTotalPages; i++) { %>
            <li class="page-item <%= incidentPage === i ? 'active' : '' %>">
              <a class="page-link" href="?tab=incidents&incident_page=<%= i %>&incident_search=<%= incidentSearch %>"><%= i %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    <% } %>
  </div>

</div>


